{
  "name": "@stock-advisor/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stock-advisor/shared": "*",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.1",
