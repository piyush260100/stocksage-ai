# Finnhub market-data API key (https://finnhub.io/register).
# When set, the server prefers Finnhub for live quotes; otherwise it uses Yahoo.
# Note: Finnhub's free tier is primarily US-focused — Indian (NSE/BSE) real-time
# quotes may require a paid plan. If Finnhub returns no data, the server falls
# back to Yahoo automatically.
FINNHUB_API_KEY=

# Optional: port the server listens on (defaults to 4000).
# PORT=4000
